# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# vercel env import file — contains live secrets, never commit
scripts/vercel-env.txt

# phase 6.2 snapshot helper + outputs — local-only, never commit
scripts/phase6-2-snapshot.ts
scripts/phase6-2-*-snapshot.json

# typescript
*.tsbuildinfo
next-env.d.ts

# phase 3 prompt iteration outputs (founder copies preserved ones into docs/)
/test-results/*
# phase 6.9.2 — un-ignore the perf summary markdown so deltas are committed
# alongside the code, but keep the bulky raw Lighthouse JSON local-only
!/test-results/phase6.9.2-baseline.md
!/test-results/phase6.9.2-results.md

# claude code session state — ignore local cache + personal settings,
# but allow team-shared memory rules + project CLAUDE.md
# (per Anthropic memory docs: .claude/rules/ + .claude/CLAUDE.md are
# team-shared via source control).
/.claude/*
!/.claude/rules/
!/.claude/rules/**
!/.claude/CLAUDE.md

# original-corpus backups (preserve locally for safety, never publish —
# they may contain copyrighted source content we deliberately replaced)
data/*.backup-*

# bhagavata raw OCR sources (CC0 archive.org djvu_txt, ~600–760 KB each;
# regenerate via curl per CLAUDE.md Phase 1.6 notes — keeps repo small)
/data/bhagavata-raw/
