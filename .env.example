# Divya Vani — environment template. Copy to .env.local and fill in real
# values. .env.local is gitignored. Never commit real keys.
#
# Required for Phase 1+ retrieval and Phase 2+ chat:
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
SUPABASE_URL=https://....supabase.co
SUPABASE_SERVICE_ROLE_KEY=...

# ---- Founder notifications ----
# Supabase Database Webhook should POST to /api/notify/telegram with this
# x-notify-secret value. TELEGRAM_* are server-only secrets.
NOTIFY_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Phase 2 RAG retrieval config (locked 2026-05-02) ----
# Drives src/lib/verses.ts. Safe defaults if any line is omitted.
# L1+L2 default-on (passed ablation). L3 ships off — Phase 7 beta can
# toggle it without redeploy. See test-results/phase2-regression-*.md
# for the ablation data behind these defaults.

# Layer 1: theme-overlap reranking
RAG_LAYER_THEME_RERANK=true
RAG_THEME_WEIGHT=0.3                    # score = cosine·0.7 + theme_overlap·0.3
RAG_CANDIDATES_K=30                     # cosine candidates fetched before rerank

# Layer 2: source-aware diversity boost
RAG_LAYER_SOURCE_DIVERSITY=true
RAG_DIVERSITY_COSINE_THRESHOLD=0.65     # missing-source chunk must clear this cosine to be force-included
RAG_DIVERSITY_SCOPE_K=10                # rerank window checked for missing sources

# Layer 3: query rewriting (DISABLED by default — ablation showed net regression)
RAG_LAYER_QUERY_REWRITE=false
RAG_REWRITE_VARIANTS=3                  # paraphrases per query (only when L3 enabled)
RAG_REWRITE_PER_VARIANT_K=10            # cosine top-k per variant before union/dedupe

# ---- Phase 5+ (Razorpay seva) ----
# Test-mode keys start with rzp_test_. Never commit live (rzp_live_) keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Phase 9 (Razorpay Subscriptions) — plan ids from scripts/setup-razorpay-plans.ts ----
# One Razorpay Plan per (tier × currency × period). INR=monthly, USD=annual at launch.
RAZORPAY_PLAN_PLUS_INR_MONTHLY=
RAZORPAY_PLAN_PLUS_USD_ANNUAL=
RAZORPAY_PLAN_VOICE_INR_MONTHLY=
RAZORPAY_PLAN_VOICE_USD_ANNUAL=
RAZORPAY_PLAN_PREMIUM_INR_MONTHLY=
RAZORPAY_PLAN_PREMIUM_USD_ANNUAL=

# ---- Phase 6.3 Sentry observability ----
# DSN is public-by-design (appears in client bundle). Auth token is server-only secret.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ---- Phase 11.2 ElevenAgents custom-LLM endpoint ----
# Bearer token ElevenAgents sends to /api/agent-llm/chat/completions. Must match
# the value stored as the CUSTOM_LLM_KEY workspace secret in the ElevenAgents
# dashboard. Server-only. Test value is "test-12345"; use a real secret in prod.
CUSTOM_LLM_KEY=

# ---- Shared rate limiting (Upstash Redis) ----
# Powers cross-instance rate limiting (src/lib/rateLimit.ts) on the AI / STT /
# TTS / payment / lead routes. Create a free Upstash Redis database at
# https://console.upstash.com and copy the REST URL + REST token here.
# FAIL-OPEN: if these are unset, rate limiting is DISABLED (requests pass through)
# — set them in Vercel production to actually enforce the limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
